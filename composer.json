{
    "name": "2lenet/pdf-generator-bundle",
    "type": "symfony-bundle",
    "description": "Pdf generator",
    "keywords": [
        "pdf"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "alexanderpavlov/pdfmerger": "^1.0",
        "doctrine/orm": "^2.6 || ^3.0",
        "laminas/laminas-escaper": "^2.11",
        "laminas/laminas-stdlib": "^3.15",
        "phpoffice/phpword": "^0.18",
        "setasign/fpdf": "1.8.4",
        "setasign/fpdi": "^2.3.6",
        "symfony/dotenv": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/http-client-contracts": "^v3.4.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0",
        "symfony/property-access": "^7.0 || ^8.0",
        "symfony/property-info": "^7.0 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "tecnickcom/tcpdf": "^6.3",
        "twig/twig": "^3.4.3",
        "vich/uploader-bundle": "^1.19 || ^2.0"
    },
    "suggest": {
        "ext-zip": "Export and import of the templates (zip archive)",
        "2lenet/crudit-bundle": "Admin screen of the PDF templates, added automatically",
        "phpstan/phpdoc-parser": "crudit_report data sources: item type of a list (@var list<Class>, iterable<Class>)"
    },
    "autoload": {
        "psr-4": {
            "Lle\\PdfGeneratorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lle\\PdfGeneratorBundle\\Tests\\": "tests/phpunit/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "2lenet/crudit-bundle": "^1.20",
        "ergebnis/phpstan-rules": "^2.1",
        "phpstan/phpdoc-parser": "^1.0 || ^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.3",
        "slevomat/coding-standard": "^8.13",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/form": "^7.0 || ^8.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
